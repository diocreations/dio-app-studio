  "rejectedAlternatives": [
    {
      "proposal": "A fourth concept that opened with 'Hand-finished in Jaipur'.",
      "rejectedBy": "ungrounded_claim",
      "why": "No sentence on the read says this. A design may not introduce a material, place or craft claim, however plausible."
    },
    {
      "proposal": "A concept that printed 'From ₹2,499' under the hero.",
      "rejectedBy": "schema_forbidden_field",
      "why": "Prices are not in the design schema at all. The renderer reads the catalogue and formats the real figure, so a model can never state one."
    },
    {
      "proposal": "A concept proposing a Visit screen.",
      "rejectedBy": "screen_unavailable",
      "why": "No address or opening hours were established, so the screen would be empty. Missing information is a question for the owner, not a screen."
    }
  ]
