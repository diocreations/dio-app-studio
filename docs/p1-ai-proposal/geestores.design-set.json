{
  "thesis": "The catalogue is the product, so each concept is an argument about how much ceremony a piece deserves before a price is read. One treats a piece as an exhibit, one as stock, one as a gift.",
  "concepts": [
    {
      "id": "vault",
      "name": "The Vault",
      "oneLine": "Dark, ceremonial, one piece at a time.",
      "architecture": {
        "header": "masthead",
        "catalog": "journal",
        "cards": "editorial",
        "detail": "feature",
        "type": "serif",
        "imagery": "portrait"
      },
      "rationale": {
        "for": "A first-time gift buyer who needs the piece to feel considered before they trust the price.",
        "whyThisBusiness": "Most catalogue entries have their own photograph, so a one-piece-per-screen journal uses the evidence the read actually supplied instead of shrinking it into a grid.",
        "tradeOff": "Fewer pieces per screen: a returning buyer scans more slowly."
      },
      "type": {
        "direction": "editorial",
        "display": "Playfair Display",
        "body": "Inter",
        "priceFont": "display",
        "weight": 500,
        "tracking": "-0.02em"
      },
      "palette": {
        "bg": "#101110",
        "surface": "#181a18",
        "surface2": "#22251f",
        "ink": "#f4f1e9",
        "muted": "#a09b8f",
        "accent": "#b8863f",
        "onAccent": "#14100b",
        "dark": true
      },
      "radius": 22,
      "nav": {
        "model": "floating",
        "initialScreen": "home",
        "tabs": ["home", "catalog", "more"],
        "labels": [
          { "screen": "home", "label": "Home" },
          { "screen": "catalog", "label": "Collection" },
          { "screen": "more", "label": "More" }
        ]
      },
      "home": {
        "composition": "title-first",
        "hero": "image",
        "heroScale": "tall",
        "density": "roomy",
        "blocks": [
          { "role": "lead", "variant": "shop-title", "layout": "split" },
          { "role": "discovery", "variant": "shop-products", "layout": "list" },
          { "role": "action", "variant": "shop-all", "layout": "list" },
          { "role": "utility", "variant": "shop-search", "layout": "grid" }
        ]
      },
      "catalogue": {
        "presentation": "one piece per row, portrait photograph, name then price",
        "card": "editorial",
        "columns": 1,
        "aspect": "portrait",
        "priceTreatment": "quiet",
        "imageFit": "cover"
      },
      "components": { "buttons": "soft", "cards": "soft", "dividers": "hairline" },
      "rhythm": { "density": "roomy", "sectionGap": "large", "blockPadding": 2 },
      "content": {
        "headings": [
          { "slot": "discovery", "text": "One piece at a time", "basis": "structural" },
          { "slot": "lead", "text": "The collection", "basis": "structural" },
          { "slot": "action", "text": "See every piece", "basis": "structural" }
        ],
        "notes": []
      },
      "differentiation": {
        "against": ["counter", "festival"],
        "axes": [
          { "axis": "typography", "value": "serif display over humanist body, display-set prices" },
          { "axis": "palette", "value": "near-black ground, warm metallic accent" },
          { "axis": "navigation", "value": "floating tab bar over content" },
          { "axis": "hero", "value": "title, then one tall portrait photograph" },
          { "axis": "hierarchy", "value": "lead > discovery > action > utility" },
          { "axis": "productPresentation", "value": "1-up journal rows" },
          { "axis": "screenStructure", "value": "home-first, collection second" },
          { "axis": "componentDesign", "value": "soft cards, hairline rules, no badges" },
          { "axis": "rhythm", "value": "roomy, large section gaps" }
        ]
      }
    },
    {
      "id": "counter",
      "name": "The Counter",
      "oneLine": "Paper light, dense, priced to compare.",
      "architecture": {
        "header": "utility",
        "catalog": "index",
        "cards": "compact",
        "detail": "spec",
        "type": "grotesk",
        "imagery": "square"
      },
      "rationale": {
        "for": "A repeat or local buyer who already knows the shop and wants to compare pieces and prices quickly.",
        "whyThisBusiness": "The read found 101 priced entries in one currency, so the honest advantage of this concept is comparison: square thumbnails, two columns, tabular prices, search first.",
        "tradeOff": "Less atmosphere: a first-time gift buyer gets no ceremony."
      },
      "type": {
        "direction": "modern",
        "display": "Space Grotesk",
        "body": "Inter",
        "priceFont": "body",
        "weight": 700,
        "tracking": "-0.035em"
