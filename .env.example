PAYMENT_ENCRYPTION_KEY=
# M0 dark-launch switches. Every flag is off when unset; unknown names are ignored.
# Comma separated name=value pairs, e.g. PLATFORM_FLAGS=accounts.enabled=1,billing.enabled=0
PLATFORM_FLAGS=
# Free-tier AI keys. Plattr spends nothing: there is no paid provider, credit
# balance or billing key in this project, and none may be added. Values belong in
# .dev.vars (gitignored) or the host's secret store, never here.
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
