PAYMENT_ENCRYPTION_KEY=
# M0 dark-launch switches. Every flag is off when unset; unknown names are ignored.
# Comma separated name=value pairs, e.g. PLATFORM_FLAGS=accounts.enabled=1,billing.enabled=0
PLATFORM_FLAGS=
# Free-tier AI keys for the shipping routes. They spend nothing: no credit
# balance or billing key is used there. Values belong in .dev.vars (gitignored)
# or the host's secret store, never here. A separate paid trial, gated further
# down, is the only path that can spend.
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# The approved paid trial: Groq vs OpenRouter on the same model. Both keys and
# the approval switch are required before any paid call; one key alone does not
# open either gateway. Keep keys in .dev.vars (gitignored) or the host's secret
# store. Never commit them, and never paste them into chat or a log. The Groq
# key is the same variable the free route uses; the trial additionally needs a
# billing-enabled Groq account. Spend is capped at $30 in total, $0.18 soft and
# $0.40 hard per generation, with no top-up path.
# OPENROUTER_API_KEY=
# PLATTR_AI_TRIAL=approved
