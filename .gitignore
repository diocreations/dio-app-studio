node_modules/
dist/
.wrangler/
.env
.env.*
.dev.vars
!.env.example

# local operator key, never committed
.studio-key

# tool state and working captures, not sources
.freebuff/
.cloud-attachments/
/screens/
/screenshots/

# intermediate renders; the shipped copies live in public/
scripts/art/*.png

# browser acceptance state: owner cookies, tokens and a throwaway profile
.chrome-qa/
# regenerable acceptance captures; the JSON reports are kept
/docs/qa/acceptance-2026-11-21/*.png

# generated trial pages; REPORT.md, report.json and the PNGs are kept
/docs/qa/ai-trial-2026-11-23/**/*.html
